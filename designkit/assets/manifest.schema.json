{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "toolkit_version": {
      "type": "string",
      "minLength": 1
    },
    "initiative": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "process": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "process",
        "outcome",
        "scope",
        "synthetic"
      ],
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_state": {
            "enum": [
              "draft",
              "in_review",
              "accepted"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "review_state"
        ],
        "additionalProperties": true
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "outcome",
              "current_step",
              "future_step",
              "requirement",
              "nfr",
              "agent",
              "human",
              "tool",
              "flow",
              "entity",
              "operation",
              "evaluation",
              "screen"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "refs"
        ],
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evaluation": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "stale"
            ]
          },
          "level": {
            "enum": [
              "simulation",
              "live_agent",
              "production",
              "structural"
            ]
          },
          "sources": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "evaluation",
          "path",
          "status",
          "level",
          "sources"
        ],
        "additionalProperties": true
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "business",
              "product",
              "experience",
              "engineering"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "accepted"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "synthetic": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "role",
          "status",
          "reviewer",
          "synthetic",
          "paths",
          "revision",
          "evidence"
        ],
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          }
        },
        "required": [
          "id",
          "owner",
          "blocking",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "toolkit_version",
    "initiative",
    "artifacts",
    "records",
    "evidence",
    "reviews",
    "questions"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
